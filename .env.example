# Variables de entorno de la API (copiar a .env solo para uso local; .env no se sube a Git)
PORT=3000            # puerto HTTP dentro del contenedor / en local
SOCKET_PORT=6061     # puerto del servidor de sockets TCP
# DB_PATH=./data/app.db   # ruta de la base SQLite (por defecto data/app.db)
# BACKUP_DIR=./backups    # carpeta de respaldos (por defecto backups/)
# GIT_SHA=local           # hash del commit; en produccion lo inyecta el pipeline
